<?xml version="1.0"?>
<ruleset name="Content Relay">
	<description>WordPress Coding Standards for the Content Relay plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/fixtures/*</exclude-pattern>
	<!-- End-to-end harness scripts run against the local clone; they are not shipped plugin code. -->
	<exclude-pattern>/tests/e2e/*</exclude-pattern>
	<!-- Local database credentials for the integration suite (gitignored). -->
	<exclude-pattern>/tests/integration/wp-tests-config.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-"/>

	<!-- WordPress = WordPress-Core + WordPress-Docs + WordPress-Extra. No rule-level exclusions. -->
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="content-relay"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="content_relay"/>
				<element value="ContentRelay"/>
			</property>
		</properties>
	</rule>
</ruleset>
